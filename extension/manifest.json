{
  "manifest_version": 3,
  "name": "Ad Blogs Bypass",
  "version": "2.0.0",
  "description": "Guarda os destinos dos links do encurtador depois que você resolve o captcha.",
  "minimum_chrome_version": "111",
  "key": "",
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ad Blogs Bypass",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png"
    }
  },
  "permissions": [
    "storage",
    "nativeMessaging",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://snet.blog/*",
    "https://www.snet.blog/*",
    "https://suaurl.com/*",
    "https://www.suaurl.com/*",
    "https://sbio.pro/*",
    "https://www.sbio.pro/*",
    "https://pagead2.googlesyndication.com/*",
    "https://ad-money.net/*",
    "https://web.telegram.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://snet.blog/*",
        "https://www.snet.blog/*",
        "https://suaurl.com/*",
        "https://www.suaurl.com/*",
        "https://sbio.pro/*",
        "https://www.sbio.pro/*"
      ],
      "js": [
        "esconde_brave.js",
        "captura.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://snet.blog/*",
        "https://www.snet.blog/*",
        "https://suaurl.com/*",
        "https://www.suaurl.com/*",
        "https://sbio.pro/*",
        "https://www.sbio.pro/*"
      ],
      "js": [
        "ponte.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "corrente",
        "enabled": true,
        "path": "regras.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "stubs/adsbygoogle.js",
        "stubs/nobetaads.js"
      ],
      "matches": [
        "https://snet.blog/*",
        "https://www.snet.blog/*",
        "https://suaurl.com/*",
        "https://www.suaurl.com/*",
        "https://sbio.pro/*",
        "https://www.sbio.pro/*"
      ]
    }
  ]
}
